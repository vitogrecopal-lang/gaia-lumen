{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["**/*"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.mjs" }
  ],
  "crons": [
    {
      "path": "/api/cron/evolve",
      "schedule": "* * * * *"
    }
  ]
}
